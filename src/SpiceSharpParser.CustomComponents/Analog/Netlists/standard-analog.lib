* SpiceSharpParser.CustomComponents portable analog special-function models.

* Analog sample/hold. SH high tracks continuously; otherwise a CLK rising edge samples.
.SUBCKT ANALOG_SAMPLE_HOLD INP INN CLK SH OUT COM PARAMS: REF=0.5 VHIGH=10 VLOW=-10 TPD=0 RIN=1G ROUT=1k COUT=500f RTRACK=1 CMEM=10p
RINP INP COM {RIN}
RINN INN COM {RIN}
RINCLK CLK COM {RIN}
RINSH SH COM {RIN}
RINITIALM MASTER COM 1
BINITIALM MASTER COM I={if(time<=0,V(MASTER,COM)-2*V(INP,INN),-V(MASTER,COM))}
CMASTER MASTER COM {CMEM} IC=0
BMASTER MASTER COM I={if(V(SH,COM)>REF,(V(MASTER,COM)-V(INP,INN))/RTRACK,if(V(CLK,COM)<REF,(V(MASTER,COM)-V(INP,INN))/RTRACK,0))}
RINITIAL STATE COM 1
BINITIAL STATE COM I={if(time<=0,V(STATE,COM)-2*V(INP,INN),-V(STATE,COM))}
BMEM STATE COM I={if(V(SH,COM)>REF,(V(STATE,COM)-V(INP,INN))/RTRACK,if(V(CLK,COM)>REF,(V(STATE,COM)-V(MASTER,COM))/RTRACK,0))}
CSTATE STATE COM {CMEM} IC=0
BSTATE RAW COM V={limit(V(STATE,COM),VLOW,VHIGH)}
BOUT DRIVE COM V={V(RAW,COM)}
ROUT DRIVE OUT {ROUT}
COUT OUT COM {COUT}
.ENDS ANALOG_SAMPLE_HOLD

* LTspice-style four-quadrant operational transconductance amplifier.
* Inputs are two differential pairs: (IN1N,IN1P) and (IN2P,IN2N).
.SUBCKT ANALOG_OTA IN1N IN1P IN2P IN2N RAIL OUT COM PARAMS: G=1 REF=0 IOUT=10u ISRC=10u ISINK=-10u IOFFSET=0 POWERUP=1 ASYM=0 LINEAR=0 ROUT=1T COUT=0 VHIGH=2 VLOW=0 RCLAMP=1
BRAW RAW COM V={(REF-V(IN1N,IN1P))*V(IN2P,IN2N)}
BGM COM OUT I={if(POWERUP>0.5,if(LINEAR>0.5,G*V(RAW,COM)+IOFFSET,if(ASYM>0.5,if(V(RAW,COM)>0,tanh(G*V(RAW,COM)/ISRC)*ISRC,tanh(G*V(RAW,COM)/ISINK)*ISINK)+IOFFSET,tanh(G*V(RAW,COM)/((ISINK-ISRC)/2))*((ISINK-ISRC)/2)+(ISINK+ISRC)/2+IOFFSET)),0)}
RLEAK OUT COM {ROUT}
COUT OUT COM {COUT}
BCLAMP OUT COM I={if(V(OUT,COM)>VHIGH,(V(OUT,COM)-VHIGH)/RCLAMP,if(V(OUT,COM)<VLOW,(V(OUT,COM)-VLOW)/RCLAMP,0))}
BRAIL RAIL COM V={VLOW}
.ENDS ANALOG_OTA

* Voltage-controlled bidirectional varistor. The control differential sets breakdown.
.SUBCKT ANALOG_VARISTOR CONTROL_P CONTROL_N OUT COM PARAMS: RCLAMP=1 ROFF=1T COUT=1p
BVAR OUT COM I={V(OUT,COM)/ROFF+if(V(OUT,COM)>abs(V(CONTROL_P,CONTROL_N)),(V(OUT,COM)-abs(V(CONTROL_P,CONTROL_N)))/RCLAMP,if(V(OUT,COM)<-abs(V(CONTROL_P,CONTROL_N)),(V(OUT,COM)+abs(V(CONTROL_P,CONTROL_N)))/RCLAMP,0))}
COUT OUT COM {COUT}
.ENDS ANALOG_VARISTOR

* Voltage-controlled oscillator. FM maps linearly from SPACE at 0 V to MARK at 1 V.
.SUBCKT ANALOG_MODULATOR FM AM OUT COM PARAMS: MARK=1k SPACE=1k ROUT=1 COUT=1p CPHASE=1 AMDEFAULT=0
RINITIAL PHASE COM 1
BINITIAL PHASE COM I={if(time<=0,V(PHASE,COM),-V(PHASE,COM))}
IBASE COM PHASE {SPACE*CPHASE}
GFM COM PHASE FM COM {(MARK-SPACE)*CPHASE}
CPHASE PHASE COM {CPHASE} IC=0
BOSC DRIVE COM V={(V(AM,COM)+AMDEFAULT)*sin(2*pi*V(PHASE,COM))}
ROUT DRIVE OUT {ROUT}
COUT OUT COM {COUT}
.ENDS ANALOG_MODULATOR
