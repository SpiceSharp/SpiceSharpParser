          Pack="true"
          PackagePath="contentFiles\any\any\SpiceSharpParser.CustomComponents\Analog" />
    <EmbeddedResource Include="Digital\Netlists\standard-digital.lib"
                      LogicalName="SpiceSharpParser.CustomComponents.Digital.standard-digital.lib" />
